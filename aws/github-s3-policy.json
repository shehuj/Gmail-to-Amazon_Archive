{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListArchiveBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::gmailstore"
    },
    {
      "Sid": "ReadWriteArchiveObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::gmailstore/*"
    }
  ]
}
